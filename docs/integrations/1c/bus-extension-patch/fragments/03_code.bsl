			//FREESPORT: вид цен клиента (dev-task-role-from-1c-agreement, A1/A3) - начало
			//Виды цен из действующих соглашений партнера. Если подходящих соглашений нет
			//или вид цен не заполнен - блок ЗначенияРеквизитов не выгружается вовсе.
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицКонтрагентов;
			Запрос.УстановитьПараметр("Контрагент", Выборка.Контрагент);
			Запрос.Текст = "ВЫБРАТЬ
			|	*
			|ИЗ
			|	ВТ_FS_ВидыЦенКонтрагентов КАК ВТ_FS_ВидыЦенКонтрагентов
			| ГДЕ ВТ_FS_ВидыЦенКонтрагентов.Контрагент = &Контрагент";
			ВыполненныйЗапросВЦ = Запрос.Выполнить();
			Если НЕ ВыполненныйЗапросВЦ.Пустой() Тогда

				ЗначенияРеквизитовКонтрагентаТип = ПолучитьТипСвойстваОтТипаОбъектаXDTO(КонтрагентТип, "ЗначенияРеквизитов");
				ЗначениеРеквизитаКонтрагентаТип	 = ПолучитьТипСвойстваОтТипаОбъектаXDTO(ЗначенияРеквизитовКонтрагентаТип, "ЗначениеРеквизита");

				ЗначенияРеквизитовКонтрагентаXDTO = СтруктураНастроек.МояФабрикаXDTO.Создать(ЗначенияРеквизитовКонтрагентаТип);

				ВыборкаВЦ = ВыполненныйЗапросВЦ.Выбрать();
				Пока ВыборкаВЦ.Следующий() Цикл

					Если НЕ ЗначениеЗаполнено(ВыборкаВЦ.ВидЦен) Тогда
						Продолжить;
					КонецЕсли;

					ДобавитьЗначениеРеквизитаXDTO(СтруктураНастроек, ЗначенияРеквизитовКонтрагентаXDTO, ЗначениеРеквизитаКонтрагентаТип, "ТипЦенId", Строка(ВыборкаВЦ.ВидЦен.УникальныйИдентификатор()));
					ДобавитьЗначениеРеквизитаXDTO(СтруктураНастроек, ЗначенияРеквизитовКонтрагентаXDTO, ЗначениеРеквизитаКонтрагентаТип, "ТипЦенНаименование", Строка(ВыборкаВЦ.ВидЦенНаименование));
					ДобавитьЗначениеРеквизитаXDTO(СтруктураНастроек, ЗначенияРеквизитовКонтрагентаXDTO, ЗначениеРеквизитаКонтрагентаТип, "СоглашениеНаименование", Строка(ВыборкаВЦ.СоглашениеНаименование));
					ДобавитьЗначениеРеквизитаXDTO(СтруктураНастроек, ЗначенияРеквизитовКонтрагентаXDTO, ЗначениеРеквизитаКонтрагентаТип, "СоглашениеТиповое", ВыборкаВЦ.СоглашениеТиповое);

				КонецЦикла;

				Если ЗначенияРеквизитовКонтрагентаXDTO.ЗначениеРеквизита.Количество() > 0 Тогда
					КонтрагентXDTO.ЗначенияРеквизитов = ЗначенияРеквизитовКонтрагентаXDTO;
				КонецЕсли;

			КонецЕсли;
